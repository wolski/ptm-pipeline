# PTM pipeline: MuData analysis stages with CBOR enrichment handoffs.
import json
import shlex
from pathlib import Path
from helpers import create_report_index, create_results_archive, get_prophosqua_file, get_prophosqua_report, get_prophosqua_install_stamp, get_kinase_cbor_files

configfile: "ptm_config.yaml"

DIR_OUT = config["dir_out"]
ANALYSES = config["analyses"]
RUN_KINASE = config.get("run_kinase", True)
PTM = get_prophosqua_file("bin/ptm.sh")
PKG = get_prophosqua_install_stamp()
KINASE, KINASE_SOURCES = get_kinase_cbor_files() if RUN_KINASE else ("", [])
COMMANDS = ("import_h5mu", "ptm_h5mu", "enrich_cbor", "assemble_h5mu", "export_h5mu", "render")
CMD = {name: get_prophosqua_file(f"CMD_{name.upper()}.R") for name in COMMANDS}
INPUTS = f"{DIR_OUT}/PTM_inputs.h5mu"
STATISTICS = f"{DIR_OUT}/PTM_statistics.h5mu"
FINAL = f"{DIR_OUT}/PTM_results.h5mu"
DIRECTORIES = {name: f"{DIR_OUT}/{value['subdir']}" for name, value in ANALYSES.items()}
DEA_ARCHIVES = {name: f"{Path(config[f'{name}_dea_dir']).name}.zip" for name in ("phospho", "protein")}
CBOR_FILES = {
    "PTMSEA": "result_ptm_sea.cbor",
    "KinaseInputs": "intermediate_kinase_inputs.cbor",
    "KinaseAssignments": "intermediate_kinase_assignments.cbor",
    "MotifEnrichment": "intermediate_mea_computation.cbor",
    "KinaseGSEA": "result_kinase_gsea.cbor",
    "MEA": "result_mea.cbor",
}
STAGES = tuple(CBOR_FILES)


def cbor_path(directory, stage):
    return f"{directory}/{CBOR_FILES[stage]}"


BRANCHES = ([cbor_path(DIRECTORIES[a], stage) for a in ANALYSES for stage in STAGES]
            if RUN_KINASE else [])
STATISTICS_REPORT = f"{DIR_OUT}/ptm_statistics.html"
ENRICHMENT_REPORTS = {name: f"{directory}/ptm_enrichment.html" for name, directory in DIRECTORIES.items()}
REPORTS = [STATISTICS_REPORT] + (list(ENRICHMENT_REPORTS.values()) if RUN_KINASE else [])
INDEX = f"{DIR_OUT}/index.html"
DELIVERY = [f"{DIR_OUT}/PTM_results.xlsx"]

rule all:
    input:
        FINAL,
        REPORTS,
        DELIVERY,
        INDEX,
        f"{DIR_OUT}.zip",
        DEA_ARCHIVES["phospho"],
        DEA_ARCHIVES["protein"]

rule import_inputs:
    input:
        enriched=config["enriched_h5ad"],
        total=config["total_h5ad"],
        configuration=workflow.configfiles,
        reference=[config["ptmsigdb"]["input_file"]] if config.get("ptmsigdb", {}).get("input_file") else [],
        wrapper=PTM,
        script=CMD["import_h5mu"],
        package=PKG
    output: h5mu=INPUTS
    log: f"{DIR_OUT}/logs/import_inputs.log"
    params:
        configuration=json.dumps(config),
        reference_flag=("--ptmsigdb " + shlex.quote(config["ptmsigdb"]["input_file"]))
            if config.get("ptmsigdb", {}).get("input_file") else ""
    shell:
        "bash {input.wrapper:q} import_h5mu --enriched {input.enriched:q} --total {input.total:q} "
        "--config_json {params.configuration:q} {params.reference_flag} --output {output.h5mu:q} > {log:q} 2>&1"

rule compute_statistics:
    input: h5mu=INPUTS, wrapper=PTM, script=CMD["ptm_h5mu"], package=PKG
    output: h5mu=STATISTICS
    log: f"{DIR_OUT}/logs/compute_statistics.log"
    shell: "bash {input.wrapper:q} ptm_h5mu --input {input.h5mu:q} --output {output.h5mu:q} > {log:q} 2>&1"

if RUN_KINASE:
    for analysis, directory in DIRECTORIES.items():
        for stage in ("PTMSEA", "KinaseInputs"):
            rule:
                name: f"build_{stage.lower()}_{analysis}"
                input: h5mu=STATISTICS, wrapper=PTM, script=CMD["enrich_cbor"], package=PKG
                output: cbor=cbor_path(directory, stage)
                log: f"{directory}/logs/{stage}.log"
                params: stage=stage, analysis=analysis.upper()
                shell:
                    "bash {input.wrapper:q} enrich_cbor --statistics {input.h5mu:q} --output {output.cbor:q} "
                    "--stage {params.stage:q} --analysis {params.analysis:q} > {log:q} 2>&1"
        rule:
            name: f"scan_motifs_{analysis}"
            input: cbor=cbor_path(directory, "KinaseInputs"), executable=KINASE, sources=KINASE_SOURCES
            output: cbor=cbor_path(directory, "KinaseAssignments")
            log: f"{directory}/logs/scan_motifs.log"
            shell: "{input.executable:q} scan {input.cbor:q} {output.cbor:q} > {log:q} 2>&1"
        rule:
            name: f"run_mea_{analysis}"
            input: kinase_inputs=cbor_path(directory, "KinaseInputs"), assignments=cbor_path(directory, "KinaseAssignments"), executable=KINASE, sources=KINASE_SOURCES
            output: cbor=cbor_path(directory, "MotifEnrichment")
            log: f"{directory}/logs/run_mea.log"
            threads: config["threads"]["mea"]
            shell: "{input.executable:q} enrich {input.kinase_inputs:q} {input.assignments:q} {output.cbor:q} --threads {threads} > {log:q} 2>&1"
        for stage in ("KinaseGSEA", "MEA"):
            rule:
                name: f"build_{stage.lower()}_{analysis}"
                input:
                    statistics=STATISTICS,
                    kinase_inputs=cbor_path(directory, "KinaseInputs"),
                    assignments=cbor_path(directory, "KinaseAssignments"),
                    motif=[cbor_path(directory, "MotifEnrichment")] if stage == "MEA" else [],
                    wrapper=PTM, script=CMD["enrich_cbor"], package=PKG
                output: cbor=cbor_path(directory, stage)
                log: f"{directory}/logs/{stage}.log"
                params:
                    stage=stage,
                    analysis=analysis.upper(),
                    motif_flag=(f"--motif_enrichment {shlex.quote(cbor_path(directory, 'MotifEnrichment'))}") if stage == "MEA" else ""
                shell:
                    "bash {input.wrapper:q} enrich_cbor --statistics {input.statistics:q} --output {output.cbor:q} "
                    "--kinase_inputs {input.kinase_inputs:q} --kinase_assignments {input.assignments:q} "
                    "{params.motif_flag} --stage {params.stage:q} --analysis {params.analysis:q} > {log:q} 2>&1"

rule assemble_results:
    input: statistics=STATISTICS, branches=BRANCHES, wrapper=PTM, script=CMD["assemble_h5mu"], package=PKG
    output: h5mu=FINAL
    log: f"{DIR_OUT}/logs/assemble_results.log"
    shell:
        "bash {input.wrapper:q} assemble_h5mu --statistics {input.statistics:q} --output {output.h5mu:q} "
        "{input.branches:q} > {log:q} 2>&1"

rule render_statistics:
    input: h5mu=STATISTICS, wrapper=PTM, script=CMD["render"], package=PKG,
           template=get_prophosqua_report("ptm_statistics.qmd")
    output: html=STATISTICS_REPORT
    log: f"{DIR_OUT}/logs/ptm_statistics.log"
    params: folder=DIR_OUT, fdr=config["fdr"], fc=config["log2fc"]
    shell:
        "bash {input.wrapper:q} render --report ptm_statistics.qmd "
        "--output_file ptm_statistics.html --output_dir {params.folder:q} "
        "input_h5mu={input.h5mu:q} fdr_threshold={params.fdr} "
        "fold_change_threshold={params.fc} > {log:q} 2>&1"

if RUN_KINASE:
    for analysis, directory in DIRECTORIES.items():
        rule:
            name: f"render_enrichment_{analysis}"
            input: h5mu=FINAL, wrapper=PTM, script=CMD["render"], package=PKG,
                   template=get_prophosqua_report("ptm_enrichment.qmd")
            output: html=ENRICHMENT_REPORTS[analysis]
            log: f"{directory}/logs/ptm_enrichment.log"
            params: folder=directory, analysis=analysis.upper(), fdr=config["fdr"]
            shell:
                "bash {input.wrapper:q} render --report ptm_enrichment.qmd "
                "--output_file ptm_enrichment.html --output_dir {params.folder:q} "
                "input_h5mu={input.h5mu:q} analysis={params.analysis:q} "
                "fdr_threshold={params.fdr} > {log:q} 2>&1"

rule top_index:
    input: reports=REPORTS
    output: html=INDEX
    run:
        create_report_index(output.html, input.reports)

rule export_delivery:
    input: h5mu=FINAL, reports=REPORTS, index=INDEX, wrapper=PTM, script=CMD["export_h5mu"], package=PKG
    output: DELIVERY
    log: f"{DIR_OUT}/logs/export_delivery.log"
    params: folder=DIR_OUT
    shell: "bash {input.wrapper:q} export_h5mu --input {input.h5mu:q} --output_dir {params.folder:q} > {log:q} 2>&1"

rule zip:
    input: delivery=DELIVERY, h5mu=FINAL, reports=REPORTS, index=INDEX
    output: results=f"{DIR_OUT}.zip", phospho=DEA_ARCHIVES["phospho"], protein=DEA_ARCHIVES["protein"]
    params: folder=DIR_OUT, phospho=config["phospho_dea_dir"], protein=config["protein_dea_dir"]
    run:
        create_results_archive(
            params.folder, output.results,
            list(input.delivery) + [input.h5mu] + list(input.reports) + [input.index]
        )
        shell("zip -r {output.phospho:q} {params.phospho:q} && zip -r {output.protein:q} {params.protein:q}")
