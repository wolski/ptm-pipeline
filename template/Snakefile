# PTM pipeline: all persisted analysis handoffs are complete MuData stages.
import json
import shlex
from pathlib import Path
from helpers import create_results_archive, get_prophosqua_file, get_prophosqua_report, get_prophosqua_install_stamp, get_kinase_cbor_files

configfile: "ptm_config.yaml"

DIR_OUT = config["dir_out"]
ANALYSES = config["analyses"]
RUN_KINASE = config.get("run_kinase", True)
PROPTM3D = config.get("proptm3d", {})
RUN_PROPTM3D = PROPTM3D.get("run", True) and RUN_KINASE
PTM = get_prophosqua_file("bin/ptm.sh")
PKG = get_prophosqua_install_stamp()
KINASE, KINASE_SOURCES = get_kinase_cbor_files() if RUN_KINASE else ("", [])
COMMANDS = ("import_h5mu", "ptm_h5mu", "enrich_cbor", "assemble_h5mu", "export_h5mu", "render", "dpu_overview")
CMD = {name: get_prophosqua_file(f"CMD_{name.upper()}.R") for name in COMMANDS}
INPUTS = f"{DIR_OUT}/PTM_inputs.h5mu"
STATISTICS = f"{DIR_OUT}/PTM_statistics.h5mu"
FINAL = f"{DIR_OUT}/PTM_results.h5mu"
DIRECTORIES = {name: f"{DIR_OUT}/{value['subdir']}" for name, value in ANALYSES.items()}
DEA_ARCHIVES = {name: f"{Path(config[f'{name}_dea_dir']).name}.zip" for name in ("phospho", "protein")}
STAGES = ("PTMSEA", "KinaseInputs", "KinaseAssignments", "MotifEnrichment", "KinaseGSEA", "MEA")
BRANCHES = ([f"{DIRECTORIES[a]}/{stage}.cbor" for a in ANALYSES for stage in STAGES]
            if RUN_KINASE else [])
REPORTS = [f"{DIRECTORIES['dpa']}/Analysis_DPA_DPU.html", f"{DIRECTORIES['cf']}/Analysis_CorrectFirst_DEA.html",
           f"{DIRECTORIES['dpu']}/Result_DPU.html"]
REPORTS += [f"{directory}/{report}.html" for directory in DIRECTORIES.values()
            for report in ("Analysis_n_to_c", "Analysis_seqlogo")]
if RUN_KINASE:
    REPORTS += [path for a, directory in DIRECTORIES.items() for path in (
        f"{directory}/PTMSEA/PTMSEA_{a.upper()}.html",
        f"{directory}/KinaseLib/Analysis_KinaseLib_{a.upper()}.html",
        f"{directory}/KinaseLib/Analysis_MEA.html")]
if RUN_PROPTM3D:
    REPORTS += [f"{directory}/proptm3d/index.html" for directory in DIRECTORIES.values()]
DELIVERY = [f"{DIR_OUT}/PTM_results.xlsx", f"{DIR_OUT}/PTM_results.rds"]
DELIVERY += [f"{DIRECTORIES[a]}/{value['xlsx_output']}" for a, value in ANALYSES.items()]
DELIVERY += [f"{DIRECTORIES[a]}/{value['xlsx_output'].removesuffix('.xlsx')}.rds" for a, value in ANALYSES.items()]
DELIVERY += [f"{DIRECTORIES['dpu']}/combined_test_diff.rds",
             f"{DIRECTORIES['cf']}/CorrectFirst_intensities_wide.xlsx",
             f"{DIRECTORIES['cf']}/CorrectFirst_intensities_file_annotation.xlsx"]
if RUN_KINASE:
    DELIVERY += [path for a, directory in DIRECTORIES.items() for path in (
        f"{directory}/PTMSEA/PTMSEA_{a.upper()}_results.xlsx",
        f"{directory}/KinaseLib/KinaseLib_GSEA_{a.upper()}.xlsx",
        f"{directory}/KinaseLib/MEA_{a.upper()}_results.xlsx",
        f"{directory}/PTMSEA/PTMSEA_{a.upper()}_results.rds",
        f"{directory}/KinaseLib/KinaseLib_GSEA_{a.upper()}.rds",
        f"{directory}/KinaseLib/MEA_{a.upper()}_results.rds")]

rule all:
    input:
        FINAL,
        REPORTS,
        DELIVERY,
        f"{DIR_OUT}/index.html",
        f"{DIR_OUT}.zip",
        DEA_ARCHIVES["phospho"],
        DEA_ARCHIVES["protein"]

rule data:
    input: FINAL

rule reports:
    input: REPORTS, f"{DIR_OUT}/index.html"

rule import_inputs:
    input:
        enriched=config["enriched_h5ad"],
        total=config["total_h5ad"],
        configuration=workflow.configfiles,
        reference=[config["ptmsigdb"]["input_file"]] if config.get("ptmsigdb", {}).get("input_file") else [],
        wrapper=PTM,
        script=CMD["import_h5mu"],
        package=PKG
    output: h5mu=INPUTS
    log: f"{DIR_OUT}/logs/import_inputs.log"
    params:
        configuration=json.dumps(config),
        reference_flag=("--ptmsigdb " + shlex.quote(config["ptmsigdb"]["input_file"]))
            if config.get("ptmsigdb", {}).get("input_file") else ""
    shell:
        "bash {input.wrapper:q} import_h5mu --enriched {input.enriched:q} --total {input.total:q} "
        "--config_json {params.configuration:q} {params.reference_flag} --output {output.h5mu:q} > {log:q} 2>&1"

rule compute_statistics:
    input: h5mu=INPUTS, wrapper=PTM, script=CMD["ptm_h5mu"], package=PKG
    output: h5mu=STATISTICS
    log: f"{DIR_OUT}/logs/compute_statistics.log"
    shell: "bash {input.wrapper:q} ptm_h5mu --input {input.h5mu:q} --output {output.h5mu:q} > {log:q} 2>&1"

if RUN_KINASE:
    for analysis, directory in DIRECTORIES.items():
        for stage in ("PTMSEA", "KinaseInputs"):
            rule:
                name: f"build_{stage.lower()}_{analysis}"
                input: h5mu=STATISTICS, wrapper=PTM, script=CMD["enrich_cbor"], package=PKG
                output: cbor=f"{directory}/{stage}.cbor"
                log: f"{directory}/logs/{stage}.log"
                params: stage=stage, analysis=analysis.upper()
                shell:
                    "bash {input.wrapper:q} enrich_cbor --statistics {input.h5mu:q} --output {output.cbor:q} "
                    "--stage {params.stage:q} --analysis {params.analysis:q} > {log:q} 2>&1"
        rule:
            name: f"scan_motifs_{analysis}"
            input: cbor=f"{directory}/KinaseInputs.cbor", executable=KINASE, sources=KINASE_SOURCES
            output: cbor=f"{directory}/KinaseAssignments.cbor"
            log: f"{directory}/logs/scan_motifs.log"
            shell: "{input.executable:q} scan {input.cbor:q} {output.cbor:q} > {log:q} 2>&1"
        rule:
            name: f"run_mea_{analysis}"
            input: kinase_inputs=f"{directory}/KinaseInputs.cbor", assignments=f"{directory}/KinaseAssignments.cbor", executable=KINASE, sources=KINASE_SOURCES
            output: cbor=f"{directory}/MotifEnrichment.cbor"
            log: f"{directory}/logs/run_mea.log"
            threads: config["threads"]["mea"]
            shell: "{input.executable:q} enrich {input.kinase_inputs:q} {input.assignments:q} {output.cbor:q} --threads {threads} > {log:q} 2>&1"
        for stage in ("KinaseGSEA", "MEA"):
            rule:
                name: f"build_{stage.lower()}_{analysis}"
                input:
                    statistics=STATISTICS,
                    kinase_inputs=f"{directory}/KinaseInputs.cbor",
                    assignments=f"{directory}/KinaseAssignments.cbor",
                    motif=[f"{directory}/MotifEnrichment.cbor"] if stage == "MEA" else [],
                    wrapper=PTM, script=CMD["enrich_cbor"], package=PKG
                output: cbor=f"{directory}/{stage}.cbor"
                log: f"{directory}/logs/{stage}.log"
                params:
                    stage=stage,
                    analysis=analysis.upper(),
                    motif_flag=(f"--motif_enrichment {shlex.quote(directory + '/MotifEnrichment.cbor')}") if stage == "MEA" else ""
                shell:
                    "bash {input.wrapper:q} enrich_cbor --statistics {input.statistics:q} --output {output.cbor:q} "
                    "--kinase_inputs {input.kinase_inputs:q} --kinase_assignments {input.assignments:q} "
                    "{params.motif_flag} --stage {params.stage:q} --analysis {params.analysis:q} > {log:q} 2>&1"

rule assemble_results:
    input: statistics=STATISTICS, branches=BRANCHES, wrapper=PTM, script=CMD["assemble_h5mu"], package=PKG
    output: h5mu=FINAL
    log: f"{DIR_OUT}/logs/assemble_results.log"
    shell:
        "bash {input.wrapper:q} assemble_h5mu --statistics {input.statistics:q} --output {output.h5mu:q} "
        "{input.branches:q} > {log:q} 2>&1"

for analysis, template in (("dpa", "Analysis_DPA_DPU.Rmd"), ("cf", "Analysis_CorrectFirst_DEA.Rmd")):
    rule:
        name: f"report_statistics_{analysis}"
        input: h5mu=FINAL, wrapper=PTM, script=CMD["render"], package=PKG, template=get_prophosqua_report(template)
        output: html=f"{DIRECTORIES[analysis]}/{template.replace('.Rmd', '.html')}"
        log: f"{DIRECTORIES[analysis]}/logs/report_statistics.log"
        params: template=template, folder=DIRECTORIES[analysis], filename=template.replace(".Rmd", ".html")
        shell:
            "bash {input.wrapper:q} render --report {params.template:q} --output_dir {params.folder:q} "
            "--output_file {params.filename:q} --intermediates_dir {output.html:q}.render "
            "input_h5mu={input.h5mu:q} > {log:q} 2>&1"

rule dpu_overview:
    input: h5mu=FINAL, wrapper=PTM, script=CMD["dpu_overview"], package=PKG
    output: html=f"{DIRECTORIES['dpu']}/Result_DPU.html"
    log: f"{DIRECTORIES['dpu']}/logs/dpu_overview.log"
    params: folder=DIRECTORIES["dpu"]
    shell: "bash {input.wrapper:q} dpu_overview --input_h5mu {input.h5mu:q} --output_dir {params.folder:q} > {log:q} 2>&1"

for analysis, directory in DIRECTORIES.items():
    for report in ("Analysis_n_to_c", "Analysis_seqlogo"):
        rule:
            name: f"{report.lower()}_{analysis}"
            input: h5mu=FINAL, wrapper=PTM, script=CMD["render"], package=PKG, template=get_prophosqua_report(f"{report}.Rmd")
            output: html=f"{directory}/{report}.html"
            log: f"{directory}/logs/{report}.log"
            params:
                template=f"{report}.Rmd", filename=f"{report}.html", folder=directory,
                sheet=analysis.upper(), analysis=analysis, fdr=config["fdr"], fc=config["log2fc"],
                extra=(f"analysis_type={analysis} max_fig={config['max_fig']} output_dir={shlex.quote(directory)}")
                    if report == "Analysis_n_to_c" else ""
            shell:
                "bash {input.wrapper:q} render --report {params.template:q} --output_file {params.filename:q} "
                "--output_dir {params.folder:q} --intermediates_dir {output.html:q}.render "
                "input_h5mu={input.h5mu:q} sheet={params.sheet:q} fdr={params.fdr} fc={params.fc} {params.extra} > {log:q} 2>&1"
    if RUN_KINASE:
        for template, relative in (("Analysis_PTMSEA.Rmd", f"PTMSEA/PTMSEA_{analysis.upper()}.html"),
                                   ("Analysis_KinaseLibrary.Rmd", f"KinaseLib/Analysis_KinaseLib_{analysis.upper()}.html"),
                                   ("Analysis_MEA.Rmd", "KinaseLib/Analysis_MEA.html")):
            rule:
                name: f"report_{template.removeprefix('Analysis_').removesuffix('.Rmd').lower()}_{analysis}"
                input: h5mu=FINAL, wrapper=PTM, script=CMD["render"], package=PKG, template=get_prophosqua_report(template)
                output: html=f"{directory}/{relative}"
                log: f"{directory}/logs/{template}.log"
                params:
                    template=template, folder=f"{directory}/{relative.rsplit('/', 1)[0]}",
                    filename=relative.rsplit("/", 1)[-1], analysis=analysis.upper(),
                    extra=("output_dir=" + shlex.quote(f"{directory}/{relative.rsplit('/', 1)[0]}"))
                        if template != "Analysis_MEA.Rmd" else ""
                shell:
                    "bash {input.wrapper:q} render --report {params.template:q} --output_file {params.filename:q} "
                    "--output_dir {params.folder:q} --intermediates_dir {output.html:q}.render "
                    "input_h5mu={input.h5mu:q} analysis_type={params.analysis:q} {params.extra} > {log:q} 2>&1"
    if RUN_PROPTM3D:
        rule:
            name: f"proptm3d_{analysis}"
            input: h5mu=FINAL
            output: html=f"{directory}/proptm3d/index.html"
            log: f"{directory}/logs/proptm3d.log"
            params:
                folder=f"{directory}/proptm3d", sheet=analysis.upper(), fdr=config["fdr"],
                repo=PROPTM3D.get("repo", "git+https://github.com/prolfqua/proptm3d"),
                maximum=f"--max_proteins {PROPTM3D['max_proteins']}" if PROPTM3D.get("max_proteins") else ""
            shell:
                "uv tool run --from {params.repo:q} proptm3d --input {input.h5mu:q} --sheet {params.sheet:q} "
                "--fdr {params.fdr} --output_dir {params.folder:q} --enrichment {input.h5mu:q} --no-html "
                "{params.maximum} > {log:q} 2>&1"

rule top_index:
    input: h5mu=FINAL, reports=REPORTS, wrapper=PTM, script=CMD["render"], package=PKG,
           template=get_prophosqua_report("create_top_index.Rmd")
    output: html=f"{DIR_OUT}/index.html"
    log: f"{DIR_OUT}/logs/top_index.log"
    params: folder=DIR_OUT
    shell:
        "bash {input.wrapper:q} render --report create_top_index.Rmd --output_file index.html "
        "--output_dir {params.folder:q} --intermediates_dir {output.html:q}.render "
        "folder={params.folder:q} input_h5mu={input.h5mu:q} > {log:q} 2>&1"

rule export_delivery:
    input: h5mu=FINAL, reports=REPORTS, index=f"{DIR_OUT}/index.html", wrapper=PTM, script=CMD["export_h5mu"], package=PKG
    output: DELIVERY
    log: f"{DIR_OUT}/logs/export_delivery.log"
    params: folder=DIR_OUT
    shell: "bash {input.wrapper:q} export_h5mu --input {input.h5mu:q} --output_dir {params.folder:q} > {log:q} 2>&1"

rule zip:
    input: delivery=DELIVERY, h5mu=FINAL, reports=REPORTS, index=f"{DIR_OUT}/index.html"
    output: results=f"{DIR_OUT}.zip", phospho=DEA_ARCHIVES["phospho"], protein=DEA_ARCHIVES["protein"]
    params: folder=DIR_OUT, phospho=config["phospho_dea_dir"], protein=config["protein_dea_dir"]
    run:
        create_results_archive(params.folder, output.results)
        shell("zip -r {output.phospho:q} {params.phospho:q} && zip -r {output.protein:q} {params.protein:q}")

rule dea:
    input: STATISTICS
rule combine:
    input: FINAL
rule n_to_c_all:
    input: [f"{directory}/Analysis_n_to_c.html" for directory in DIRECTORIES.values()]
rule seqlogo_all:
    input: [f"{directory}/Analysis_seqlogo.html" for directory in DIRECTORIES.values()]
rule ptmsea_all:
    input: [f"{DIRECTORIES[a]}/PTMSEA/PTMSEA_{a.upper()}.html" for a in ANALYSES] if RUN_KINASE else []
rule kinaselib_all:
    input: [f"{DIRECTORIES[a]}/KinaseLib/Analysis_KinaseLib_{a.upper()}.html" for a in ANALYSES] if RUN_KINASE else []
rule vis_mea_all:
    input: [f"{directory}/KinaseLib/Analysis_MEA.html" for directory in DIRECTORIES.values()] if RUN_KINASE else []
rule proptm3d_all:
    input: [f"{directory}/proptm3d/index.html" for directory in DIRECTORIES.values()] if RUN_PROPTM3D else []
rule clean:
    shell: "snakemake --delete-all-output"

rule help:
    run:
        print("Targets: data (final MuData), reports (HTML from MuData), all (reports, terminal exports and archives)")
